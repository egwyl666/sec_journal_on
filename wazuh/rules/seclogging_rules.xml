<!--
  Правила оповіщень для подій, які вмикає sec_journal_on (Windows і Linux).
  Встановлення на менеджері: скопіюйте файл у /var/ossec/etc/rules/ і перезапустіть wazuh-manager.
  Діапазон ID: 12300-12343 (спершу Windows, далі Linux).

  Кожне правило прив'язане (if_sid) до найглибшого стандартного правила, до якого доходить подія:
  Wazuh перевіряє дочірні правила в порядку завантаження й іде за першим, що збіглося, тож правило,
  прив'язане вище по дереву, перехопить стандартне правило-сусід. if_group windows не використовується:
  з кількома такими правилами wazuh-analysisd 4.14 падає під час запуску.
  Правила Linux - дочірні до 80700 (auditd) за ключем правила аудиту (-k), який ставить set-security-logging.sh.
  Перевірено на wazuh-manager 4.14: tests/wazuh-rules.sh подає події як агент і звіряє, яке правило спрацювало.
-->

<group name="seclogging,seclogging_windows,">

  <!-- ===== Захист журналів і аудиту ===== -->

  <rule id="12300" level="12">
    <if_sid>63103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^1102$</field>
    <options>no_full_log</options>
    <description>Журнал Security очищено ($(win.eventdata.subjectUserName))</description>
    <mitre><id>T1070.001</id></mitre>
    <group>log_cleared,</group>
  </rule>

  <rule id="12301" level="10">
    <if_sid>63104</if_sid>
    <field name="win.system.eventID">^104$</field>
    <field name="win.system.providerName">Eventlog</field>
    <options>no_full_log</options>
    <description>Журнал подій Windows очищено ($(win.eventdata.channel))</description>
    <mitre><id>T1070.001</id></mitre>
    <group>log_cleared,</group>
  </rule>

  <rule id="12302" level="10">
    <if_sid>63108</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^1100$</field>
    <options>no_full_log</options>
    <description>Служба журналу подій зупинена (може бути вимкнення ПК або приховування слідів)</description>
    <mitre><id>T1562.002</id></mitre>
  </rule>

  <rule id="12303" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4719$</field>
    <options>no_full_log</options>
    <description>Змінено політику аудиту ($(win.eventdata.subjectUserName))</description>
    <mitre><id>T1562.002</id></mitre>
  </rule>

  <!-- ===== Sysmon і сам SecLogging ===== -->

  <rule id="12304" level="12">
    <if_sid>61606</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^4$</field>
    <field name="win.eventdata.state">^Stopped$</field>
    <options>no_full_log</options>
    <description>Sysmon зупинено</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <rule id="12305" level="10">
    <if_sid>61644</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^16$</field>
    <options>no_full_log</options>
    <description>Змінено конфігурацію Sysmon ($(win.eventdata.configuration))</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <rule id="12306" level="10">
    <if_sid>60602</if_sid>
    <field name="win.system.providerName">^SecLogging$</field>
    <field name="win.system.eventID">^1002$</field>
    <description>SecLogging: не вдалося застосувати налаштування журналювання - див. last-report.json на хості</description>
  </rule>

  <rule id="12307" level="4">
    <if_sid>60601</if_sid>
    <field name="win.system.providerName">^SecLogging$</field>
    <field name="win.system.eventID">^1001$</field>
    <description>SecLogging: налаштування застосовано з попередженнями</description>
  </rule>

  <rule id="12308" level="3">
    <if_sid>60600</if_sid>
    <field name="win.system.providerName">^SecLogging$</field>
    <field name="win.system.eventID">^1000$</field>
    <description>SecLogging: налаштування застосовано</description>
  </rule>

  <!-- ===== Закріплення: служби ===== -->

  <rule id="12309" level="8">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4697$</field>
    <options>no_full_log</options>
    <description>Встановлено службу $(win.eventdata.serviceName): $(win.eventdata.serviceFileName)</description>
    <mitre><id>T1543.003</id></mitre>
  </rule>

  <rule id="12310" level="8">
    <if_sid>61100</if_sid>
    <field name="win.system.channel">^System$</field>
    <field name="win.system.eventID">^7045$</field>
    <options>no_full_log</options>
    <description>Встановлено службу $(win.eventdata.serviceName): $(win.eventdata.imagePath)</description>
    <mitre><id>T1543.003</id></mitre>
  </rule>

  <!-- ===== Привілейовані групи (за SID, тож працює з будь-якою мовою Windows) ===== -->
  <!-- 512 Domain Admins, 518 Schema Admins, 519 Enterprise Admins, 520 Group Policy Creator Owners,
       S-1-5-32-544 Administrators, 548 Account Operators, 549 Server Operators, 550 Print Operators, 551 Backup Operators -->

  <rule id="12311" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
    <field name="win.eventdata.targetSid" type="pcre2">(?i)^S-1-5-21-[0-9-]+-(512|518|519|520)$|^S-1-5-32-(544|548|549|550|551)$</field>
    <options>no_full_log</options>
    <description>Додано до привілейованої групи $(win.eventdata.targetUserName): $(win.eventdata.memberName)</description>
    <mitre><id>T1098</id></mitre>
  </rule>

  <!-- ===== Атаки на AD ===== -->

  <rule id="12312" level="14">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">(?i)1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2|89e95b76-444d-4c62-991a-0facbeda640c</field>
    <field name="win.eventdata.subjectUserName" type="pcre2" negate="yes">\$$</field>
    <options>no_full_log</options>
    <description>Можливий DCSync: реплікацію каталогу запитав не контролер домену ($(win.eventdata.subjectUserName))</description>
    <mitre><id>T1003.006</id></mitre>
  </rule>

  <rule id="12313" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <field name="win.eventdata.status">^0x0$</field>
    <field name="win.eventdata.serviceName" type="pcre2" negate="yes">(?i)\$$|^krbtgt$</field>
    <options>no_full_log</options>
    <description>Можливий Kerberoasting: квиток RC4 на службу $(win.eventdata.serviceName) для $(win.eventdata.targetUserName)</description>
    <mitre><id>T1558.003</id></mitre>
  </rule>

  <rule id="12314" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.preAuthType">^0$</field>
    <field name="win.eventdata.status">^0x0$</field>
    <options>no_full_log</options>
    <description>Можливий AS-REP roasting: квиток без попередньої автентифікації для $(win.eventdata.targetUserName)</description>
    <mitre><id>T1558.004</id></mitre>
  </rule>

  <rule id="12315" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4794$</field>
    <options>no_full_log</options>
    <description>Змінено пароль режиму відновлення служб каталогів (DSRM)</description>
    <mitre><id>T1098</id></mitre>
  </rule>

  <rule id="12316" level="8">
    <if_sid>60103</if_sid>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^5136$</field>
    <field name="win.eventdata.objectClass">^groupPolicyContainer$</field>
    <options>no_full_log</options>
    <description>Змінено об'єкт групової політики $(win.eventdata.objectDN)</description>
    <mitre><id>T1484.001</id></mitre>
  </rule>

  <rule id="12317" level="5">
    <if_sid>60009, 60010, 60011</if_sid>
    <field name="win.system.channel">^Directory Service$</field>
    <field name="win.system.eventID">^2889$</field>
    <options>no_full_log</options>
    <description>LDAP-прив'язка без підпису або simple bind від $(win.eventdata.param1) ($(win.eventdata.param2))</description>
    <mitre><id>T1557</id></mitre>
  </rule>

  <!-- ===== LSASS ===== -->

  <rule id="12318" level="10">
    <if_sid>60009, 60010, 60011</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-CodeIntegrity/Operational$</field>
    <field name="win.system.eventID">^3065$|^3066$</field>
    <options>no_full_log</options>
    <description>У LSASS завантажено непідписаний модуль $(win.eventdata.fileNameBuffer)</description>
    <mitre><id>T1547.008</id></mitre>
  </rule>

</group>

<group name="windows,service_installation,lunette,">

  <!-- Служба з каталогу, куди може писати користувач. Дочірні до правил 4697/7045 вище:
       окреме базове правило на 4697 не спрацювало б - подію першим забирає правило "Встановлено службу". -->
  <rule id="12319" level="12">
    <if_sid>12309</if_sid>
    <field name="win.eventdata.serviceFileName" type="pcre2">(?i)\\(users|temp|appdata|programdata|downloads|пользователи)\\</field>
    <description>Windows: служба з підозрілого каталогу - $(win.eventdata.serviceFileName)</description>
    <mitre><id>T1543.003</id></mitre>
  </rule>

  <rule id="12320" level="12">
    <if_sid>12310</if_sid>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)\\(users|temp|appdata|programdata|downloads|пользователи)\\</field>
    <description>Windows: служба з підозрілого каталогу - $(win.eventdata.imagePath)</description>
    <mitre><id>T1543.003</id></mitre>
  </rule>

</group>

<group name="seclogging,seclogging_linux,">

  <!-- ===== auditd: ключі правил з set-security-logging.sh ===== -->

  <rule id="12321" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^auditlog$</field>
    <description>Auditd: зміна журналів аудиту /var/log/audit ($(audit.exe))</description>
    <mitre><id>T1070.002</id></mitre>
  </rule>

  <rule id="12322" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^auditconfig$</field>
    <description>Auditd: змінено конфігурацію аудиту ($(audit.exe))</description>
    <mitre><id>T1562.012</id></mitre>
  </rule>

  <rule id="12323" level="6">
    <if_sid>80700</if_sid>
    <field name="audit.key">^audittools$</field>
    <description>Auditd: запущено auditctl/auditd ($(audit.exe))</description>
    <mitre><id>T1562.012</id></mitre>
  </rule>

  <rule id="12324" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^rootkey$</field>
    <description>Auditd: змінено ключі SSH користувача root ($(audit.exe))</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>

  <rule id="12325" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^preload$</field>
    <description>Auditd: змінено ld.so.preload / ld.so.conf ($(audit.exe))</description>
    <mitre><id>T1574.006</id></mitre>
  </rule>

  <rule id="12326" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^webshell$</field>
    <description>Auditd: веб-сервер запустив програму ($(audit.exe)) - можливий веб-шел</description>
    <mitre><id>T1505.003</id></mitre>
  </rule>

  <rule id="12327" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^sudoers$</field>
    <description>Auditd: змінено sudoers ($(audit.exe))</description>
    <mitre><id>T1548.003</id></mitre>
  </rule>

  <rule id="12328" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^pam$</field>
    <description>Auditd: змінено налаштування PAM ($(audit.exe))</description>
    <mitre><id>T1556.003</id></mitre>
  </rule>

  <rule id="12329" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^code_injection$</field>
    <description>Auditd: запис у пам'ять іншого процесу через ptrace ($(audit.exe))</description>
    <mitre><id>T1055.008</id></mitre>
  </rule>

  <rule id="12330" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^identity$</field>
    <description>Auditd: змінено облікові записи або групи (passwd/shadow/group) ($(audit.exe))</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <rule id="12331" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^user_mgmt$</field>
    <description>Auditd: керування користувачами ($(audit.exe))</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <rule id="12332" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^sshd$</field>
    <description>Auditd: змінено конфігурацію sshd ($(audit.exe))</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>

  <rule id="12333" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^cron$</field>
    <description>Auditd: змінено завдання cron/at ($(audit.exe))</description>
    <mitre><id>T1053.003</id></mitre>
  </rule>

  <rule id="12334" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^shellprofile$</field>
    <description>Auditd: змінено профіль оболонки ($(audit.exe))</description>
    <mitre><id>T1546.004</id></mitre>
  </rule>

  <rule id="12335" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^login$</field>
    <description>Auditd: змінено login.defs / nsswitch.conf ($(audit.exe))</description>
    <mitre><id>T1556</id></mitre>
  </rule>

  <!-- часто змінюються оновленнями пакетів: низький рівень, для розслідувань -->
  <rule id="12336" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^systemd$|^init$</field>
    <description>Auditd: змінено служби systemd/init ($(audit.exe))</description>
    <mitre><id>T1543.002</id></mitre>
  </rule>

  <rule id="12337" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^modules$</field>
    <description>Auditd: завантаження або вивантаження модуля ядра ($(audit.exe))</description>
    <mitre><id>T1547.006</id></mitre>
  </rule>

  <rule id="12338" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^time$</field>
    <description>Auditd: змінено системний час ($(audit.exe))</description>
    <mitre><id>T1070.006</id></mitre>
  </rule>

  <rule id="12339" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^passwd_change$</field>
    <description>Auditd: запущено passwd ($(audit.exe))</description>
  </rule>

  <rule id="12340" level="3">
    <if_sid>80700</if_sid>
    <field name="audit.key">^netconf$|^mount$|^priv_esc$</field>
    <description>Auditd: $(audit.key) ($(audit.exe))</description>
  </rule>

</group>

<group name="seclogging,seclogging_linux,">

  <!-- помилки перевіряються раніше за попередження: спрацьовує перше дочірнє правило, що збіглося -->
  <!-- підсумок set-security-logging.sh (logger -t seclogging) містить "Error=", тож стандартне 1002 спрацьовує завжди -->
  <rule id="12341" level="3">
    <if_sid>1002</if_sid>
    <program_name>^seclogging$</program_name>
    <description>SecLogging: налаштування застосовано</description>
  </rule>

  <rule id="12342" level="10">
    <if_sid>12341</if_sid>
    <match type="pcre2">\bError=[1-9]</match>
    <description>SecLogging: не вдалося застосувати налаштування журналювання - див. /var/log/seclogging/last-report.json</description>
  </rule>

  <rule id="12343" level="4">
    <if_sid>12341</if_sid>
    <match type="pcre2">\bWarning=[1-9]</match>
    <description>SecLogging: налаштування застосовано з попередженнями</description>
  </rule>

</group>
